with open('input.txt', 'r') as f:
   data = f.read()
   lines = data.split('\n')
   filtered_lines = []
   for line in lines:
       if not line[0] == '#':
           filtered_lines.append(line)
   output = '\n'.join(filtered_lines)
   
print(output)

